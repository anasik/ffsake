        "type": "text",
        "text": "{\"ok\":true,\"result\":{\"files\":[{\"path\":\"FibonacciGenerator.cs\",\"read\":{\"end_line\":30,\"path\":\"FibonacciGenerator.cs\",\"start_line\":1,\"text\":\"\ufeffusing System;\\nusing System.Collections.Generic;\\n\\nnamespace Hello\\n{\\n    public class FibonacciGenerator\\n    {\\n        private Dictionary<int, int> _cache = new Dictionary<int, int>();\\n\\n        private int Fib(int n) => n < 2 ? n : FibValue(n - 1) + FibValue(n - 2);\\n\\n        private int FibValue(int n)\\n        {\\n            if (!_cache.ContainsKey(n))\\n            {\\n                _cache.Add(n, Fib(n));\\n            }\\n\\n            return _cache[n];\\n        }\\n\\n        public IEnumerable<int> Generate(int n)\\n        {\\n            for (int i = 0; i < n; i++)\\n            {\\n                yield return FibValue(i);\\n            }\\n        }\\n    }\\n}\",\"total_lines\":30},\"status\":\"ok\"},{\"path\":\"Program.cs\",\"read\":{\"end_line\":20,\"path\":\"Program.cs\",\"start_line\":1,\"text\":\"using System;\\nusing System.Linq;\\nnamespace Hello\\n{\\n    class Program\\n    {\\n        static void Main()\\n        {\\n            var generator = new FibonacciGenerator();\\n            var terms = generator.Generate(48).ToArray();\\n            long actual = terms[47];\\n            Print(actual);\\n            if (actual != 2971215073L) Environment.ExitCode = 1;\\n        }\\n        static void Print(long actual)\\n        {\\n            Console.WriteLine(actual);\\n        }\\n    }\\n}\",\"total_lines\":20},\"status\":\"ok\"},{\"path\":\"Fibonacci.csproj\",\"read\":{\"end_line\":1,\"path\":\"Fibonacci.csproj\",\"start_line\":1,\"text\":\"<Project Sdk=\\\"Microsoft.NET.Sdk\\\"><PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><DebugType>portable</DebugType><Optimize>false</Optimize></PropertyGroup></Project>\",\"total_lines\":1},\"status\":\"ok\"}]}}"
      }
